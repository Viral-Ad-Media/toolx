# Local development only. Production must use DEBUG=False and real values below.
DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_ORIGIN=http://localhost:8000
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Production (replace every placeholder):
# DEBUG=False
# SECRET_KEY=<random-secret-at-least-50-characters>
# ALLOWED_HOSTS=toolx.yourdomain.com
# PUBLIC_ORIGIN=https://toolx.yourdomain.com
# DATABASE_URL=postgresql://user:password@host:5432/toolx
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=<smtp-host>
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=<smtp-user>
# EMAIL_HOST_PASSWORD=<smtp-password>
# ADMIN_EMAIL=<verified-sender-address>
# AWS_STORAGE_BUCKET_NAME=<private-media-bucket>
# AWS_S3_REGION_NAME=<bucket-region>
# AWS_ACCESS_KEY_ID=<access-key-or-use-workload-credentials>
# AWS_SECRET_ACCESS_KEY=<secret-key>
# AWS_S3_ENDPOINT_URL=<optional-s3-compatible-endpoint>
